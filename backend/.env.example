# === App ===
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:///./storage/chatbot.db

# === Identity / Branding ===
# The assistant persona and the platform it is currently assigned to.
ASSISTANT_NAME=MyVivahAI
PLATFORM_NAME=Dishavadhuvar
# "soft": welcome + ask for the MatriID once, then allow guest browsing.
# "hard": block all service until a MatriID is linked.
MATRI_ID_GATE_MODE=soft
# When the chat onboarding may start searching early:
#   gender_plus_core (default) | gender_only | full_only
ONBOARDING_SEARCH_STRATEGY=gender_plus_core

# === JWT ===
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# === LLM Provider ===
# "ollama" (local) | "groq" | "cerebras" | "gemini" (cloud)
LLM_PROVIDER=gemini

# === Groq API (free, get at https://console.groq.com) ===
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VERIFY_SSL=true

# === Cerebras API (free, get at https://cloud.cerebras.ai) ===
CEREBRAS_API_KEY=csk_your_cerebras_api_key
CEREBRAS_MODEL=llama-3.3-70b

# === Google Gemini API (free, get at https://aistudio.google.com/apikey) ===
GEMINI_API_KEY=AIza_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# === MySQL (matrimony database) ===
# Set these to your real MySQL host/credentials in backend/.env
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_password
DB_NAME=your_mysql_database
DB_CONNECT_TIMEOUT=10

# === Photos ===
PHOTO_BASE_URL=https://dishavadhuvar.com/gallary/

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
